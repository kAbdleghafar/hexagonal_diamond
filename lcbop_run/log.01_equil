# ---------------- 1c. NPT again, average the cell -------------------
reset_timestep 0
fix            npt all npt temp ${T0} ${T0} 0.1 aniso 0.0 0.0 1.0
fix            npt all npt temp 300.0 ${T0} 0.1 aniso 0.0 0.0 1.0
fix            npt all npt temp 300.0 300.0 0.1 aniso 0.0 0.0 1.0
fix            avg all ave/time 20 ${nrep} ${navg} v_Lx v_Ly v_Lz v_PGPa
fix            avg all ave/time 20 200 ${navg} v_Lx v_Ly v_Lz v_PGPa
fix            avg all ave/time 20 200 4000 v_Lx v_Ly v_Lz v_PGPa
run            ${navg}
run            4000
