unfix          relax
reset_timestep 0

# ---------------- 1b. NPT at T0 / 0 bar -----------------------------
# aniso (not iso): graphite is extremely anisotropic, x/y/z must relax
# independently
velocity       all create ${T0} ${seed} mom yes rot yes dist gaussian
velocity       all create 300.0 ${seed} mom yes rot yes dist gaussian
velocity       all create 300.0 4928459 mom yes rot yes dist gaussian
fix            npt all npt temp ${T0} ${T0} 0.1 aniso 0.0 0.0 1.0
fix            npt all npt temp 300.0 ${T0} 0.1 aniso 0.0 0.0 1.0
fix            npt all npt temp 300.0 300.0 0.1 aniso 0.0 0.0 1.0
run            ${nnpt}
run            8000
