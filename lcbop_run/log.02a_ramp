variable       L0   equal ${Ll}
variable       L0   equal 135.660054855946
variable       V0   equal $(vol)
variable       V0   equal 1136228.3002525097691
variable       E0   equal $(etotal)
variable       E0   equal -934152.58532511477824
variable       P0   equal ${Pl}
variable       P0   equal 33.7817826337373
variable       rho0 equal $(density)               # g/cc
variable       rho0 equal 2.2467861927433112612               
variable       kB     equal 8.617333262e-5         # eV/K
variable       nktv2p equal 1.6021765e6            # bar*A^3 per eV

variable       strain  equal (v_L0-v_Ll)/v_L0
variable       VV0     equal vol/v_V0
variable       eta     equal 1.0-vol/v_V0
variable       Pl_GPa  equal v_Pl/1.0e4
variable       Pt_GPa  equal (pxx+pyy+pzz-v_Pl)/2.0e4   # mean lateral stress
variable       tau_GPa equal (v_Pl_GPa-v_Pt_GPa)/2.0     # max shear stress
# departure from the Rankine-Hugoniot energy, in K (same definition as MSST's dhugoniot):
#   (E_H - E)/(3 N kB),  E_H = E0 + 0.5*(P+P0)*(V0-V)
#   = 0 on the Hugoniot, > 0 colder than the shock state at this V (quasi-isentropic ramp)
variable       dhug equal (0.5*(v_Pl+v_P0)*(v_V0-vol)/v_nktv2p-(etotal-v_E0))/(3.0*atoms*v_kB)
# shock that would reach the same (P, V) state along a Rayleigh line
variable       Us_eq equal sqrt(abs(v_Pl-v_P0)*1.0e5/(v_rho0*1.0e3*(v_eta+1.0e-12)))/1.0e3   # km/s
variable       up_eq equal v_Us_eq*v_eta                                                     # km/s

print          "Reference: L0 = ${L0} A, V0 = ${V0} A^3, rho0 = ${rho0} g/cc, P0 = $(v_P0/1e4) GPa, E0 = ${E0} eV"
Reference: L0 = 135.660054855946 A, V0 = 1136228.30025251 A^3, rho0 = 2.24678619274331 g/cc, P0 = 0.0033781782633737298532 GPa, E0 = -934152.585325115 eV

# ---------------- loading parameters ------------------------------
variable       erate equal -${srate}*1.0e-12        # 1/ps (metal time unit)
variable       erate equal -5e10*1.0e-12        
variable       nramp equal round(${emax}/(${srate}*1.0e-12)/${dt})
variable       nramp equal round(0.45/(${srate}*1.0e-12)/${dt})
variable       nramp equal round(0.45/(5e10*1.0e-12)/${dt})
variable       nramp equal round(0.45/(5e10*1.0e-12)/0.0005)
variable       nhold equal round(${thold}/${dt})
variable       nhold equal round(2/${dt})
variable       nhold equal round(2/0.0005)
print          "Ramp: strain rate ${srate} 1/s -> erate ${erate} 1/ps, ${nramp} steps to strain ${emax}; hold ${nhold} steps"
Ramp: strain rate 5e10 1/s -> erate -0.05 1/ps, 18000 steps to strain 0.45; hold 4000 steps

# ---------------- output -------------------------------------------
reset_timestep 0
thermo_style   custom step time v_strain v_VV0 density temp pe etotal press                v_Pl_GPa v_Pt_GPa v_tau_GPa v_dhug v_fsp3 v_fsp2 v_Us_eq v_up_eq
thermo_modify  flush yes
thermo         ${nout}
thermo         200

fix            prof all print ${nout} "$(step) $(time:%.4f) $(v_strain:%.5f) $(v_VV0:%.5f) $(density:%.4f) $(temp:%.2f) $(v_Pl_GPa:%.4f) $(v_Pt_GPa:%.4f) $(v_tau_GPa:%.4f) $(v_dhug:%.2f) $(v_fsp3:%.5f) $(v_fsp2:%.5f) $(v_Us_eq:%.4f) $(v_up_eq:%.4f)"                file ramp_profile.txt screen no                title "# step time(ps) strain V/V0 rho(g/cc) T(K) P_long(GPa) P_lat(GPa) tau(GPa) dHug(K) f_sp3 f_sp2 Us_eq(km/s) up_eq(km/s)"
fix            prof all print 200 "$(step) $(time:%.4f) $(v_strain:%.5f) $(v_VV0:%.5f) $(density:%.4f) $(temp:%.2f) $(v_Pl_GPa:%.4f) $(v_Pt_GPa:%.4f) $(v_tau_GPa:%.4f) $(v_dhug:%.2f) $(v_fsp3:%.5f) $(v_fsp2:%.5f) $(v_Us_eq:%.4f) $(v_up_eq:%.4f)"                file ramp_profile.txt screen no                title "# step time(ps) strain V/V0 rho(g/cc) T(K) P_long(GPa) P_lat(GPa) tau(GPa) dHug(K) f_sp3 f_sp2 Us_eq(km/s) up_eq(km/s)"

dump           d1 all custom ${ndump} dump.ramp.lammpstrj id type x y z vx vy vz c_cn c_peatom
dump           d1 all custom 2000 dump.ramp.lammpstrj id type x y z vx vy vz c_cn c_peatom
dump_modify    d1 sort id

restart        20000 ramp.restart.1 ramp.restart.2

# ---------------- 2a-1. compression at constant strain rate -------
fix            nve all nve
fix            compress all deform 1 ${dir} erate ${erate} remap x
fix            compress all deform 1 z erate ${erate} remap x
fix            compress all deform 1 z erate -0.05 remap x
run            ${nramp}
run            18000
